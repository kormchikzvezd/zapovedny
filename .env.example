# Скопируйте в .env и заполните. Сам .env в git не попадает.
# Права на сервере: chmod 600 .env

# Порт, на котором слушает приложение. nginx проксирует на него.
PORT=3000

# Публичный адрес. Обязателен: по нему проверяется Origin при приёме заявок.
PUBLIC_ORIGIN=https://zapovedny-dom.online

# Где хранить базу заявок.
DATA_DIR=/opt/zapovedny/data
DB_PATH=/opt/zapovedny/data/leads.db

# Уведомления о новых заявках в Telegram. Без них заявки всё равно
# сохраняются, но менеджер о них не узнает.
# Токен: @BotFather -> /newbot.  Chat ID: @userinfobot или getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=